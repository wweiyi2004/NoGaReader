<Window x:Class="NoGaReader.Dialogs.NoteDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="添加笔记"
        Width="500" Height="410"
        MinWidth="440" MinHeight="350"
        ResizeMode="CanResizeWithGrip"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Background="{DynamicResource WindowBackgroundBrush}"
        PreviewKeyDown="Window_PreviewKeyDown">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">
            <TextBlock Text="阅读笔记" FontSize="{StaticResource FontSizeCaption}" FontWeight="SemiBold"
                       Foreground="{DynamicResource PrimaryBrush}"/>
            <TextBlock x:Name="HeadingText" Text="为这段文字添加笔记" Margin="0,6,0,0"
                       FontSize="20" FontWeight="SemiBold"/>
            <Border Margin="0,15,0,0" Padding="14,12" CornerRadius="{StaticResource RadiusMd}"
                    Background="{DynamicResource PrimarySoftBrush}"
                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                <TextBlock x:Name="QuoteText" TextWrapping="Wrap" MaxHeight="72"
                           TextTrimming="CharacterEllipsis" Style="{StaticResource CaptionTextStyle}" LineHeight="19"/>
            </Border>
        </StackPanel>

        <StackPanel Grid.Row="1" Margin="0,16,0,0">
            <TextBlock Text="颜色" Style="{StaticResource CaptionTextStyle}"/>
            <Border Margin="0,7,0,0" Padding="3" CornerRadius="{StaticResource RadiusMd}"
                    Background="{DynamicResource SurfaceAltBrush}">
                <UniformGrid Columns="4">
                    <ToggleButton x:Name="YellowButton" Content="黄色" Tag="yellow"
                                  IsChecked="True" Style="{StaticResource SegmentButtonStyle}"
                                  Checked="ColorButton_Checked"/>
                    <ToggleButton x:Name="GreenButton" Content="绿色" Tag="green"
                                  Style="{StaticResource SegmentButtonStyle}" Checked="ColorButton_Checked"/>
                    <ToggleButton x:Name="BlueButton" Content="蓝色" Tag="blue"
                                  Style="{StaticResource SegmentButtonStyle}" Checked="ColorButton_Checked"/>
                    <ToggleButton x:Name="PinkButton" Content="粉色" Tag="pink"
                                  Style="{StaticResource SegmentButtonStyle}" Checked="ColorButton_Checked"/>
                </UniformGrid>
            </Border>
        </StackPanel>

        <TextBox Grid.Row="2" x:Name="NoteTextBox" Margin="0,16,0,0" Height="Auto" MinHeight="110"
                 Padding="12,10" VerticalContentAlignment="Top"
                 Background="{DynamicResource SurfaceBrush}"
                 AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                 TextChanged="NoteTextBox_TextChanged"/>

        <Grid Grid.Row="3" Margin="0,18,0,0">
            <TextBlock Text="Ctrl+Enter 保存" Style="{StaticResource CaptionTextStyle}" VerticalAlignment="Center"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="取消" Width="86" Margin="0,0,8,0" Click="CancelButton_Click"/>
                <Button x:Name="SaveButton" Content="保存笔记" Width="104" IsEnabled="False"
                        Style="{StaticResource PrimaryButtonStyle}" Click="SaveButton_Click"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
