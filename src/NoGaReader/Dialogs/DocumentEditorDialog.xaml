<Window x:Class="NoGaReader.Dialogs.DocumentEditorDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="文档编辑器"
        Width="1100" Height="760"
        MinWidth="860" MinHeight="560"
        WindowStartupLocation="CenterOwner"
        PreviewKeyDown="Window_PreviewKeyDown"
        Closing="Window_Closing"
        AutomationProperties.Name="文档编辑器">
    <DockPanel>
        <Border DockPanel.Dock="Top" Padding="12,10"
                Background="{DynamicResource SurfaceAltBrush}"
                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock x:Name="TitleText" Text="未命名文档" FontSize="18" FontWeight="SemiBold"/>
                    <TextBlock x:Name="PathText" Margin="0,4,0,0" Style="{StaticResource CaptionTextStyle}"
                               Text="尚未保存"/>
                </StackPanel>
                <TextBlock Grid.Column="1" x:Name="StatsText" VerticalAlignment="Center"
                           Style="{StaticResource CaptionTextStyle}" Text="0 字 · 0 词"/>
            </Grid>
        </Border>

        <ToolBarTray DockPanel.Dock="Top">
            <ToolBar Band="0" BandIndex="0">
                <Button Content="新建" Click="NewButton_Click" ToolTip="Ctrl+N"/>
                <Button Content="打开" Click="OpenButton_Click" ToolTip="Ctrl+O"/>
                <Button Content="保存" Click="SaveButton_Click" ToolTip="Ctrl+S"/>
                <Button Content="另存为" Click="SaveAsButton_Click"/>
                <Separator/>
                <Button Content="撤销" Command="ApplicationCommands.Undo"/>
                <Button Content="重做" Command="ApplicationCommands.Redo"/>
                <Separator/>
                <Button Content="剪切" Command="ApplicationCommands.Cut"/>
                <Button Content="复制" Command="ApplicationCommands.Copy"/>
                <Button Content="粘贴" Command="ApplicationCommands.Paste"/>
                <Separator/>
                <ToggleButton x:Name="BoldButton" Content="B" FontWeight="Bold" Width="32"
                              Click="BoldButton_Click" ToolTip="粗体"/>
                <ToggleButton x:Name="ItalicButton" Content="I" FontStyle="Italic" Width="32"
                              Click="ItalicButton_Click" ToolTip="斜体"/>
                <ToggleButton x:Name="UnderlineButton" Content="U" Width="32"
                              Click="UnderlineButton_Click" ToolTip="下划线"/>
                <Separator/>
                <Button Content="打印" Click="PrintButton_Click" ToolTip="Ctrl+P"/>
                <Button Content="查找" Click="FindButton_Click" ToolTip="Ctrl+F"/>
            </ToolBar>
        </ToolBarTray>

        <Border DockPanel.Dock="Bottom" Padding="12,8"
                Background="{DynamicResource SurfaceAltBrush}"
                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="StatusText" Text="就绪" VerticalAlignment="Center"
                           Foreground="{DynamicResource MutedTextBrush}"/>
                <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="0,0,12,0">
                    <TextBox x:Name="FindBox" Width="180" Height="30" Margin="0,0,8,0"
                             VerticalContentAlignment="Center"
                             AutomationProperties.Name="查找文本"/>
                    <Button Content="查找下一个" Padding="10,6" Click="FindNextButton_Click"/>
                </StackPanel>
                <Button Grid.Column="2" Content="关闭" Padding="14,7" Click="CloseButton_Click"/>
            </Grid>
        </Border>

        <Border Margin="16" Background="{DynamicResource SurfaceBrush}"
                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                CornerRadius="{StaticResource RadiusMd}">
            <RichTextBox x:Name="Editor"
                         BorderThickness="0"
                         AcceptsTab="True"
                         VerticalScrollBarVisibility="Auto"
                         HorizontalScrollBarVisibility="Auto"
                         Padding="8"
                         SpellCheck.IsEnabled="False"
                         TextChanged="Editor_TextChanged"
                         SelectionChanged="Editor_SelectionChanged"
                         AutomationProperties.Name="文档正文编辑区">
                <RichTextBox.Resources>
                    <Style TargetType="{x:Type Paragraph}">
                        <Setter Property="Margin" Value="0,0,0,10"/>
                    </Style>
                </RichTextBox.Resources>
            </RichTextBox>
        </Border>
    </DockPanel>
</Window>
