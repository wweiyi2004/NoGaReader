<Window x:Class="NoGaReader.Dialogs.ReaderSettingsDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="阅读设置"
        Width="520" Height="620"
        MinWidth="480" MinHeight="560"
        SizeToContent="Height"
        MaxHeight="760"
        ResizeMode="CanResizeWithGrip"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Background="{DynamicResource WindowBackgroundBrush}"
        PreviewKeyDown="Window_PreviewKeyDown"
        AutomationProperties.Name="阅读设置">
    <Border Padding="28,24,28,22">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Margin="0,0,0,20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Margin="0,0,16,0">
                    <TextBlock Text="阅读设置" FontSize="22" FontWeight="SemiBold"/>
                    <TextBlock Margin="0,6,0,0" TextWrapping="Wrap" LineHeight="20"
                               Foreground="{DynamicResource MutedTextBrush}"
                               Text="调整背景、分页和正文字号。改动会立即应用到当前阅读页。"/>
                </StackPanel>
                <Button Grid.Column="1" Style="{StaticResource IconButtonStyle}"
                        Width="36" Height="36" VerticalAlignment="Top"
                        ToolTip="关闭" AutomationProperties.Name="关闭阅读设置"
                        Click="CloseButton_Click">
                    <TextBlock Text="&#xE711;" Style="{StaticResource IconGlyphStyle}" FontSize="14"/>
                </Button>
            </Grid>

            <StackPanel Grid.Row="1">
                <TextBlock Text="阅读背景" FontSize="13" FontWeight="SemiBold"
                           Foreground="{DynamicResource MutedTextBrush}"/>
                <Border Margin="0,10,0,20" Padding="4" CornerRadius="{StaticResource RadiusMd}"
                        Background="{DynamicResource SurfaceAltBrush}">
                    <UniformGrid Columns="4">
                        <ToggleButton x:Name="AutoReaderThemeButton" Content="跟随应用" Tag="Auto" Height="40"
                                      Style="{StaticResource SegmentButtonStyle}"
                                      Checked="ReaderThemeButton_Checked"/>
                        <ToggleButton x:Name="PaperReaderThemeButton" Content="纸张" Tag="Paper" Height="40"
                                      Style="{StaticResource SegmentButtonStyle}"
                                      Checked="ReaderThemeButton_Checked"/>
                        <ToggleButton x:Name="LightReaderThemeButton" Content="明亮" Tag="Light" Height="40"
                                      Style="{StaticResource SegmentButtonStyle}"
                                      Checked="ReaderThemeButton_Checked"/>
                        <ToggleButton x:Name="DarkReaderThemeButton" Content="夜间" Tag="Dark" Height="40"
                                      Style="{StaticResource SegmentButtonStyle}"
                                      Checked="ReaderThemeButton_Checked"/>
                    </UniformGrid>
                </Border>

                <TextBlock Text="阅读方式" FontSize="13" FontWeight="SemiBold"
                           Foreground="{DynamicResource MutedTextBrush}"/>
                <Border Margin="0,10,0,22" Padding="4" CornerRadius="{StaticResource RadiusMd}"
                        Background="{DynamicResource SurfaceAltBrush}">
                    <UniformGrid Columns="2">
                        <ToggleButton x:Name="PagedFlowButton" Content="分页" Tag="Paged" Height="40"
                                      Style="{StaticResource SegmentButtonStyle}"
                                      Checked="ReaderFlowButton_Checked"/>
                        <ToggleButton x:Name="ScrollingFlowButton" Content="滚动" Tag="Scrolling" Height="40"
                                      Style="{StaticResource SegmentButtonStyle}"
                                      Checked="ReaderFlowButton_Checked"/>
                    </UniformGrid>
                </Border>

                <Grid Margin="0,0,0,8">
                    <TextBlock Text="正文字号" FontSize="13" FontWeight="SemiBold"
                               Foreground="{DynamicResource MutedTextBrush}"/>
                    <TextBlock x:Name="FontSizeValueText" HorizontalAlignment="Right"
                               FontSize="13" FontWeight="SemiBold"/>
                </Grid>
                <Slider x:Name="FontSizeSlider" Style="{StaticResource ReaderSliderStyle}"
                        Height="28" Margin="0,0,0,4"
                        Minimum="14" Maximum="30" TickFrequency="1" IsSnapToTickEnabled="True"
                        ValueChanged="ReaderSlider_ValueChanged"/>

                <Grid Margin="0,18,0,8">
                    <TextBlock Text="行距" FontSize="13" FontWeight="SemiBold"
                               Foreground="{DynamicResource MutedTextBrush}"/>
                    <TextBlock x:Name="LineHeightValueText" HorizontalAlignment="Right"
                               FontSize="13" FontWeight="SemiBold"/>
                </Grid>
                <Slider x:Name="LineHeightSlider" Style="{StaticResource ReaderSliderStyle}"
                        Height="28" Margin="0,0,0,4"
                        Minimum="1.4" Maximum="2.4" TickFrequency="0.05" IsSnapToTickEnabled="True"
                        ValueChanged="ReaderSlider_ValueChanged"/>

                <Grid Margin="0,18,0,8">
                    <TextBlock Text="版心宽度" FontSize="13" FontWeight="SemiBold"
                               Foreground="{DynamicResource MutedTextBrush}"/>
                    <TextBlock x:Name="ContentWidthValueText" HorizontalAlignment="Right"
                               FontSize="13" FontWeight="SemiBold"/>
                </Grid>
                <Slider x:Name="ContentWidthSlider" Style="{StaticResource ReaderSliderStyle}"
                        Height="28" Margin="0,0,0,4"
                        Minimum="560" Maximum="1000" TickFrequency="20" IsSnapToTickEnabled="True"
                        ValueChanged="ReaderSlider_ValueChanged"/>

                <CheckBox x:Name="UsePublisherFontCheck" Margin="0,22,0,0"
                          Content="使用 EPUB 原字体（关闭后统一为系统字体）"
                          Checked="UsePublisherFontCheck_Changed"
                          Unchecked="UsePublisherFontCheck_Changed"/>
                <TextBlock Margin="0,8,0,0" TextWrapping="Wrap" LineHeight="18"
                           Foreground="{DynamicResource MutedTextBrush}" FontSize="12"
                           Text="默认保留出版社字体与 @font-face。需要更统一的阅读观感时可关闭。"/>

                <Button Content="恢复舒适默认值" Margin="0,20,0,0" Height="42"
                        Background="{DynamicResource SurfaceAltBrush}"
                        BorderBrush="{DynamicResource BorderBrush}"
                        Click="ResetButton_Click"/>
                <TextBlock Margin="0,14,0,0" TextWrapping="Wrap" LineHeight="20"
                           Foreground="{DynamicResource MutedTextBrush}" FontSize="12"
                           Text="“跟随应用”与控制台明暗一致（应用设为“跟随系统”时也会跟系统）。纸张/明亮/夜间为固定阅读底色。"/>
            </StackPanel>

            <Grid Grid.Row="2" Margin="0,22,0,0">
                <TextBlock VerticalAlignment="Center" FontSize="12"
                           Foreground="{DynamicResource MutedTextBrush}"
                           Text="Esc 关闭"/>
                <Button Content="完成" Width="108" Height="42" HorizontalAlignment="Right"
                        Style="{StaticResource PrimaryButtonStyle}"
                        Click="CloseButton_Click"
                        AutomationProperties.Name="完成阅读设置"/>
            </Grid>
        </Grid>
    </Border>
</Window>
